{
  "name": "penilaian-gudang",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Aplikasi Android inspeksi / penilaian gudang (Capacitor + React)",
  "scripts": {
    "build": "node build.mjs",
    "build:test": "TEST_STUBS=1 node build.mjs",
